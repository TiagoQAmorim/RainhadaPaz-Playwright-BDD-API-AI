# URL pública do site (produção ou ngrok para testar pagamentos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredo para cookies de sessão do admin (gere uma string longa aleatória)
AUTH_SECRET=altere-para-uma-chave-segura-de-pelo-menos-32-caracteres

# Admin inicial (criado no seed se não existir)
ADMIN_EMAIL=admin@paroquiarainhadapaz.com.br
ADMIN_PASSWORD=AltereEstaSenha123!

# Mercado Pago — https://www.mercadopago.com.br/developers
# Use credenciais de TESTE durante desenvolvimento
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Valor padrão da vela virtual (em reais)
CANDLE_PRICE_BRL=10

# true = vela gratuita (testes). false = exige pagamento quando Mercado Pago estiver ativo
CANDLE_FREE_MODE=true

# true = confirma cotas da rifa sem Mercado Pago (testes). false = exige pagamento
RAFFLE_FREE_MODE=true

# Fallback se não configurado no admin (Admin → Velas)
CANDLE_DURATION_HOURS=8

# E-mail ao acender vela (destino = e-mail em Admin → Informações)
# SMTP_HOST=smtp.seudominio.com.br
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=velas@paroquiarainhadapaz.com.br

# Banco SQLite (desenvolvimento)
DATABASE_URL="file:./dev.db"

# Playwright — URL base (opcional; padrão http://localhost:3000)
# PLAYWRIGHT_BASE_URL=http://localhost:3000

# Teste E2E com juiz por IA (e2e/ai) — opcional
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com
# E2E_AI_MODEL=gpt-4o-mini
