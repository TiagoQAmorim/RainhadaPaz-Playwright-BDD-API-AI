# URL pública do site (produção ou túnel para testar pagamentos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Com `npm run tunnel`: use https://rainhadapaz-preview.loca.lt (subdomínio fixo no localtunnel)
# Quick tunnel Cloudflare (`npm run tunnel:cloudflare`) gera nome aleatório — não dá para escolher.
# Após mudar o túnel, reinicie `npm run dev` se algo não carregar (allowedDevOrigins em next.config.ts).
# URL fixa no domínio da paróquia: tunnel nomeado Cloudflare → preview.paroquiarainhadapaz.com.br (ver cloudflared/config.example.yml)

# Segredo para cookies de sessão do admin (gere uma string longa aleatória)
AUTH_SECRET=altere-para-uma-chave-segura-de-pelo-menos-32-caracteres

# Admin inicial (criado no seed se não existir)
ADMIN_EMAIL=admin@paroquiarainhadapaz.com.br
ADMIN_PASSWORD=AltereEstaSenha123!

# Pagamentos: PIX via conta Itaú (src/lib/parish-payments.ts). Cartão: Sicredi — ver docs/pagamentos-sicredi.md
# SICREDI_ENABLED=false
# SICREDI_CLIENT_ID=
# SICREDI_CLIENT_SECRET=

# Valor padrão da vela virtual (em reais)
CANDLE_PRICE_BRL=10

# true = vela gratuita (só testes E2E). Omita ou false em produção.
CANDLE_FREE_MODE=false

# true = rifa sem PIX (só testes E2E). Omita ou false em produção.
RAFFLE_FREE_MODE=false

# Fallback se não configurado no admin (Admin → Velas)
CANDLE_DURATION_HOURS=8

# E-mail das velas pela API do Zoho (HTTPS, porta 443). Destino = Admin → Velas.
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
# ZOHO_ACCOUNT_ID=
# ZOHO_FROM_EMAIL=velas@paroquiarainhadapaz.com.br
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# ZOHO_MAIL_API_URL=https://mail.zoho.com

# Banco SQLite (desenvolvimento local)
DATABASE_URL="file:./dev.db"
# Railway (produção): volume montado em /data — ver docs/hospedagem-railway.md
# DATABASE_URL="file:/data/rainhadapaz.db"

# Playwright — URL base (opcional; padrão http://localhost:3000)
# PLAYWRIGHT_BASE_URL=http://localhost:3000

# Teste E2E com juiz por IA (e2e/ai) — opcional
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com
# E2E_AI_MODEL=gpt-4o-mini
