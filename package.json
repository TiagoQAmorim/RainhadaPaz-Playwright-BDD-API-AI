{
  "name": "rainhada-paz-playwright-bdd-api-ai",
  "version": "0.1.0",
  "description": "Parish portal (Next.js) with Playwright-BDD E2E, API tests, and AI testing examples",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/next-build.mjs",
    "start": "node scripts/ensure-db.mjs",
    "start:next": "next start --hostname 0.0.0.0",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "export:site-bundle": "node scripts/export-site-bundle.mjs",
    "sync:bundle-uploads": "node scripts/sync-bundle-uploads.mjs",
    "db:import-bundle": "tsx prisma/import-bundle.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "import:wp": "tsx scripts/import-wp-content.ts",
    "images:localize": "tsx scripts/localize-site-images.ts",
    "import:saints": "tsx scripts/import-saints-catalog.ts",
    "export:saints": "tsx scripts/export-saints-excel.ts",
    "db:sync-saints": "tsx scripts/sync-saints-to-db.ts",
    "db:refresh-client": "prisma db push && prisma generate",
    "test": "vitest run",
    "test:e2e": "bddgen && playwright test --project=portal",
    "test:e2e:all": "bddgen && playwright test",
    "test:e2e:api": "playwright test --project=api",
    "test:e2e:ai": "bddgen && playwright test --project=ai",
    "test:e2e:ui:ai": "bddgen && playwright test --ui --project=ai",
    "test:e2e:ui": "bddgen && playwright test --ui --project=portal",
    "test:e2e:ui:all": "bddgen && playwright test --ui",
    "bddgen": "bddgen",
    "tunnel:lt": "npx localtunnel --port 3000 --subdomain rainhadapaz-preview",
    "preview:tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/preview-tunnel.ps1",
    "tunnel:cloudflare": "npx --yes cloudflared tunnel --url http://127.0.0.1:3000",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@tiptap/extension-color": "^3.34.0",
    "@tiptap/extension-link": "^3.34.0",
    "@tiptap/extension-text-style": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.13",
    "next": "^16.4.3",
    "nodemailer": "^10.3.1",
    "pix-payload": "^1.0.4",
    "prisma": "^5.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-qr-code": "^2.2.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "pdf-parse": "^1.1.1",
    "playwright-bdd": "^9.2.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4",
    "xlsx": "^0.18.5"
  }
}
