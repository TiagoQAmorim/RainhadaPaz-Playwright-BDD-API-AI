{
  "name": "rainhada-paz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "import:wp": "tsx scripts/import-wp-content.ts",
    "import:saints": "tsx scripts/import-saints-catalog.ts",
    "db:sync-saints": "tsx scripts/sync-saints-to-db.ts",
    "db:refresh-client": "prisma db push && prisma generate",
    "test": "vitest run",
    "test:e2e": "bddgen && playwright test --project=portal",
    "test:e2e:all": "bddgen && playwright test",
    "test:e2e:api": "playwright test --project=api",
    "test:e2e:ai": "bddgen && playwright test --project=ai",
    "test:e2e:ui:ai": "bddgen && playwright test --ui --project=ai",
    "test:e2e:ui": "bddgen && playwright test --ui --project=portal",
    "test:e2e:ui:all": "bddgen && playwright test --ui",
    "bddgen": "bddgen",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.13",
    "mercadopago": "^3.6.1",
    "next": "^16.4.3",
    "nodemailer": "^10.3.1",
    "prisma": "^5.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "pdf-parse": "^1.1.1",
    "playwright-bdd": "^9.2.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
