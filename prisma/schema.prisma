generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model SiteSettings {
  id              Int    @id @default(1)
  parishName      String
  diocese         String
  address         String
  phone           String
  email           String?
  whatsapp        String?
  heroTitle       String
  heroSubtitle    String
  aboutHtml       String
  // Banner da página institucional. Vazio mantém só o texto.
  aboutBannerUrl  String?
  showMatrizMap   Boolean @default(false)
  showCapelaMap   Boolean @default(false)
  massScheduleHtml String
  pixKey          String?
  instagramUrl    String?
  youtubeUrl      String?
  facebookUrl     String?
  logoUrl         String?
  heroImageUrl    String?
  heroImageUrl2   String?
  heroImageUrl3   String?
  matrizImageUrl  String?
  capelaImageUrl  String?
  // Resultado no Google e prévia do WhatsApp. Vazio usa o nome, a frase do banner e a foto 1.
  searchTitle       String?
  searchDescription String?
  searchImageUrl    String?
  youtubeChannelUrl String?
  tercoOnlineSchedule String?
  tercoOnlineLink     String?
  candleDurationAmount Int     @default(8)
  candleDurationUnit   String   @default("hours")
  candlesNotifyEmail   String?
  // free | free_donation | paid
  candleAccessMode     String   @default("paid")
  candlePriceCents     Int      @default(1000)
  candlePaymentPix     Boolean  @default(true)
  candlePaymentSicredi Boolean  @default(false)
  maintenanceEnabled   Boolean  @default(false)
  maintenanceMessage   String?
  maintenanceEndsAt    DateTime?
  // Semana (domingo) cujo relatório de velas já foi enviado na sexta.
  candleWeekReportKey  String?
  // Textos dos e-mails. Vazio usa o modelo padrão. Tags: <nome>, <intencao>, <oracao>.
  candleLitEmailSubject    String?
  candleLitEmailBody       String?
  candleExpiryEmailSubject String?
  candleExpiryEmailBody    String?
  candleWeekEmailSubject   String?
  candleWeekEmailIntro     String?
  candleWeekEmailItem      String?
  // Minutos antes de apagar para avisar quem acendeu. Padrão: 60.
  candleExpiryNoticeMinutes Int @default(60)
}

model Post {
  id                     String             @id @default(cuid())
  title                  String
  slug                   String             @unique
  excerpt                String
  body                   String
  coverImage             String?
  published              Boolean            @default(false)
  publishedAt            DateTime?
  featuredOnHomeCarousel Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  galleryImages          PostGalleryImage[]
  youtubeVideos          PostYoutubeVideo[]
}

model PostGalleryImage {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  imageUrl  String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model PostYoutubeVideo {
  id             String   @id @default(cuid())
  postId         String
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  youtubeVideoId String
  title          String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String
  startsAt    DateTime
  location    String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Page {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  body           String
  featuredImage  String?
  published      Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

model HomeQuickLink {
  id          String  @id @default(cuid())
  title       String
  description String
  href        String
  imageUrl    String
  external    Boolean @default(false)
  sortOrder   Int     @default(0)
  published   Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HomeHeroCta {
  id        String @id @default(cuid())
  label     String
  href      String
  variant   String @default("primary")
  sortOrder Int    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notice {
  id          String    @id @default(cuid())
  title       String
  body        String
  coverImage  String?
  published   Boolean   @default(true)
  featuredOnHomeCarousel Boolean @default(false)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model MassLocation {
  id           String   @id @default(cuid())
  name         String
  address      String
  scheduleText String
  imageUrl     String?
  sortOrder    Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Terço online: dias/horário + link por bloco
model TercoOnlineSlot {
  id           String   @id @default(cuid())
  title        String   @default("Terço online")
  scheduleText String
  meetingUrl   String
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VirtualCandle {
  id              String         @id @default(cuid())
  donorName       String
  intention       String
  prayer          String?
  intentionPublic Boolean        @default(false)
  prayerPublic    Boolean        @default(false)
  email           String?
  phone           String?
  parishNotifiedAt DateTime?
  amountCents     Int
  status          String         @default("PENDING")
  paymentMethod   String?
  mercadoPagoId   String?        @unique
  preferenceId    String?
  litAt           DateTime?
  expiresAt       DateTime?
  expiryReminderSentAt DateTime?
  createdAt       DateTime       @default(now())
}

// ——— Rifa dos Santos ———

model Saint {
  id          Int            @id @default(autoincrement())
  name        String
  feastDay    Int
  feastMonth  Int
  celebration String
  description String
  createdAt   DateTime       @default(now())
  tickets     RaffleTicket[]

  @@unique([name, feastDay, feastMonth])
  @@index([feastMonth, feastDay])
  @@index([name])
}

model Raffle {
  id                   String         @id @default(cuid())
  slug                 String         @unique
  title                String
  description          String
  purpose              String?
  coverImageUrl        String?
  prizeTitle           String
  prizeDescription     String?
  prizeImageUrl        String?
  // JSON com os caminhos das fotos do premio. A primeira tambem fica em prizeImageUrl.
  prizeImageUrls       String?
  ticketPriceCents     Int
  totalTickets         Int
  status               String         @default("DRAFT")
  featuredOnHome       Boolean        @default(false)
  startsAt             DateTime?
  endsAt               DateTime?
  drawScheduledAt      DateTime?
  reservationMinutes   Int            @default(5)
  drawWinningNumber    Int?
  drawWinnerName       String?
  drawWinnerContact    String?
  drawNotes            String?
  drawRecordedAt       DateTime?
  // SAINTS = cota por santo. NUMBERS = serie numerica, fisica e virtual.
  kind                 String         @default("SAINTS")
  // Primeiro numero da serie virtual. Nulo nas rifas de santos.
  numberStart          Int?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  tickets              RaffleTicket[]
  orders               RaffleOrder[]
  draws                RaffleDraw[]
}

model RaffleDraw {
  id            String   @id @default(cuid())
  raffleId      String
  raffle        Raffle   @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  winningNumber Int
  winnerName    String?
  winnerContact String?
  // ALL = serie inteira (fisico + virtual). SOLD = so numeros vendidos no site.
  scope         String
  notes         String?
  drawnAt       DateTime @default(now())

  @@index([raffleId, drawnAt])
}

model RaffleTicket {
  id                   String       @id @default(cuid())
  raffleId             String
  raffle               Raffle       @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  saintId              Int?
  saint                Saint?       @relation(fields: [saintId], references: [id])
  ticketNumber         Int
  status               String       @default("AVAILABLE")
  reservationExpiresAt DateTime?
  reservedSessionId    String?
  soldAt               DateTime?
  orderLine            RaffleOrderTicket?

  @@unique([raffleId, ticketNumber])
  @@unique([raffleId, saintId])
  @@index([raffleId, status])
}

model RaffleOrder {
  id             String              @id @default(cuid())
  raffleId       String
  raffle         Raffle              @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  buyerName      String
  buyerEmail     String
  buyerPhone     String
  buyerCpf       String?
  totalCents     Int
  status         String              @default("PENDING")
  idempotencyKey String?             @unique
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  lines          RaffleOrderTicket[]
  payments       RafflePayment[]
}

model RaffleOrderTicket {
  id       String        @id @default(cuid())
  orderId  String
  order    RaffleOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketId String        @unique
  ticket   RaffleTicket  @relation(fields: [ticketId], references: [id])
}

model RafflePayment {
  id                   String      @id @default(cuid())
  orderId              String
  order                RaffleOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider             String      @default("pix_parish")
  externalPaymentId    String?     @unique
  externalPreferenceId String?
  status               String      @default("PENDING")
  confirmedAt          DateTime?
  rawPayload           String?
  createdAt            DateTime    @default(now())
}
